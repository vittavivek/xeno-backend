generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id         Int     @id @default(autoincrement())
  shopifyId  String  @unique
  email      String?
  firstName  String?
  lastName   String?
  tenantId   String
}

model Product {
  id         Int     @id @default(autoincrement())
  shopifyId  String  @unique
  title      String
  price      Float
  tenantId   String
}

model Order {
  id         Int      @id @default(autoincrement())
  shopifyId  String   @unique
  amount     Float
  createdAt  DateTime
  tenantId   String
}
